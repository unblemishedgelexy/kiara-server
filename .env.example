PORT=4000
NODE_ENV=production
SERVER_URL=http://localhost:4000

# Add your deployed web frontend plus native app origins.
# Keep capacitor://localhost and ionic://localhost for Android/iOS WebView builds.
# Set ALLOWED_ORIGINS in Render to the real deployed frontend origin(s).
ALLOWED_ORIGINS=https://kiaraai.netlify.app,https://kiaraai.in,http://localhost:5173,http://localhost:5174
CLIENT_ORIGIN=capacitor://localhost,ionic://localhost,http://localhost,http://localhost:8100

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=
JWT_ACCESS_SECRET=<generate-a-random-secret-at-least-32-characters>
JWT_REFRESH_SECRET=<generate-a-different-random-secret-at-least-32-characters>
AES_SECRET=<generate-a-random-secret-at-least-32-characters>
# Required for provisioning additional admins. First-admin bootstrap is disabled in the API.
ADMIN_REGISTRATION_KEY=
COOKIE_DOMAIN=

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Leda
GROQ_API_KEY=
GROQ_TEXT_FALLBACK_ENABLED=false

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Email delivery. Production defaults to SES; local development defaults to discard.
EMAIL_PROVIDER=ses
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=verified-sender@example.com
EMAIL_FROM=verified-sender@example.com
# SES uses the AWS SDK default credential chain (prefer an IAM role; do not commit access keys).
# SES account, sender identity, and recipient sandbox status must be configured in AWS.

# Optional providers only when explicitly selected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Redis Configuration for Short-Term Memory (STM)
# Use Redis Cloud (https://redis.com/try-free/) or local Redis
# If REDIS_URL is provided, it will be used first.
# For passwordless Redis leave REDIS_PASSWORD blank.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
TRUST_PROXY=1
ABUSE_MAX_IN_FLIGHT_PER_IP=20
ABUSE_MAX_IN_FLIGHT_PER_ACCOUNT=10
ABUSE_BURST_MAX=120
ABUSE_BURST_WINDOW_SECONDS=10
ABUSE_BLOCK_SECONDS=30
ABUSE_LEASE_SECONDS=120
AUTH_ABUSE_MAX_IN_FLIGHT_PER_IP=20
AUTH_ABUSE_BURST_MAX=120
AUTH_ABUSE_BURST_WINDOW_SECONDS=10
AUTH_ABUSE_BLOCK_SECONDS=30
AUTH_ABUSE_LEASE_SECONDS=120
MAX_ACTIVE_LIVE_SESSIONS_PER_ACCOUNT=2

# ImageKit is used for profile images and new APK releases (ImageKit plan size limit: 25 MiB).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/profiles

# Optional legacy Cloudflare R2 settings. Keep these only if an older APK is still stored in R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Razorpay subscription integration. Keep all secret values on the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_ID=
RAZORPAY_PLAN_PRO_ID=
RAZORPAY_PLAN_PREMIUM_ID=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
SUBSCRIPTION_STARTER_PRICE_INR=199
SUBSCRIPTION_STARTER_LIVE_MINUTES=60
SUBSCRIPTION_STARTER_CHAT_MESSAGES=300
SUBSCRIPTION_PRO_PRICE_INR=299
SUBSCRIPTION_PRO_LIVE_MINUTES=180
SUBSCRIPTION_PRO_CHAT_MESSAGES=1000
SUBSCRIPTION_PREMIUM_PRICE_INR=399
SUBSCRIPTION_PREMIUM_LIVE_MINUTES=400
SUBSCRIPTION_PREMIUM_CHAT_MESSAGES=2500

# Pinecone Configuration for Long-Term Memory (LTM)
# Create account at https://www.pinecone.io
# Create an index with dimension 1024 and cosine metric
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=kiara-long-term-memory
PINECONE_VECTOR_DIMENSION=1024

# Memory System Settings
MEMORY_CANONICAL_WRITE_MODE=legacy
MEMORY_GROQ_QUERY_PLANNER_ENABLED=false
MEMORY_RETRIEVAL_SOURCE_TIMEOUT_MS=10000
MEMORY_RETRIEVAL_TIMEOUT_MS=10000
LIVE_MEMORY_RETRIEVAL_TIMEOUT_MS=5000
MEMORY_MONGO_QUERY_TIMEOUT_MS=3000
MEMORY_RECENT_MESSAGE_LIMIT=10
MEMORY_SUMMARY_BATCH_SIZE=5
MEMORY_SUMMARY_TRIGGER=5
SHORT_TERM_MEMORY_TTL=3600
